{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "methis-ai",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "browser": {
    "binding": "BROWSER"
  },
  "vars": {
    "METHIS_ALLOWED_HOSTS": "yuniko-api.lafatriniainaallane.workers.dev"
  }
}
